<!--
title: Blog | Flock
description: Blog for the Flock fork of Flutter.
-->
<!doctype html>

<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <title>{{  title  }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description|escape }}">

  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png">
  <link rel="manifest" href="/images/favicon/site.webmanifest">
  <link rel="mask-icon" href="/images/favicon/safari-pinned-tab.svg" color="#f8217e">
  <link rel="shortcut icon" href="/images/favicon/favicon.ico">
  <meta name="msapplication-TileColor" content="#0d0912">
  <meta name="msapplication-config" content="/images/favicon/browserconfig.xml">
  <meta name="theme-color" content="#0d0912">

  <link rel="canonical" href="https://getflocked.dev{{ url|escape }}">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description|escape }}" />
  <meta property="og:url" content="https://getflocked.dev{{ url|escape }}" />
  {{ components.socialImage() }}

  <!-- X/Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@suprdeclarative" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description|escape }}" />

  <link href="/styles/styles.css" rel="stylesheet">
  <link href="/styles/blog-directory.css" rel="stylesheet">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
  <link href="/styles/navigation.css" rel="stylesheet">
</head>

<body class="themed blog-page">
{{ components.navBar({"activeSection": "blog"}) }}
<section class="blog-hero" aria-hidden="true">
  <img src="/images/blog/fleek-at-desk-typing.webp" width="1920" height="634" alt="" fetchpriority="high">
</section>

<main>
  <h1>BLOG</h1>
  <p>The latest news about Flock and Nest.</p>
  <section id="posts">
    <ol class="post-list">
      {% for page in pages.byTag("post", sortBy="publishDate=desc") %}
      <li>
        <a href="{{ page.data['url'] }}">
          <div class="post-synopsis">
            <div class="content">
              {% if page.data['publishDate'] is defined %}
              <span class="publish-date above">{{ page.data['publishDate'] | formatDateTime(to = "MMMM dd, yyyy") }}</span>
              {% endif %}
              <h2 class="title">{{ page.data['title'] }}</h2>
              <p class="description">{{ page.data['description'] }}</p>
              <p>
                <span class="permalink">{{ page.data['url'] }}</span>
              </p>
            </div>
          </div>
        </a>
      </li>
      {% endfor %}
    </ol>
  </section>
</main>

{{ components.footer() }}
</body>
</html>
