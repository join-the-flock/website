<!doctype html>

<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="utf-8">
  <title>{{  title  }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description|escape }}">

  <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png">
  <link rel="manifest" href="/images/favicon/site.webmanifest">
  <link rel="mask-icon" href="/images/favicon/safari-pinned-tab.svg" color="#f8217e">
  <link rel="shortcut icon" href="/images/favicon/favicon.ico">
  <meta name="theme-color" content="#0d0912">

  <!-- Open Graph -->
  <meta property="og:title" content="{{ title }}" />
  <meta property="og:description" content="{{ description|escape }}" />
  <meta property="og:url" content="https://getflocked.dev{{ url|escape }}" />
  {{ components.socialImage() }}

  <!-- X/Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@suprdeclarative" />
  <meta name="twitter:title" content="{{ title }}" />
  <meta name="twitter:description" content="{{ description|escape }}" />

  <link href="/styles/styles.css" rel="stylesheet">
  <link href="/styles/guide.css" rel="stylesheet">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..800;1,400..800&family=Fira+Mono:wght@400;500;700&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Noto+Serif:ital,wght@0,100..900;1,100..900&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">
  <link href="/styles/navigation.css" rel="stylesheet">
  <script src="/scripts/flock-section-navigation.js" defer></script>
  {% if code_examples %}
  <link href="/styles/code-examples.css" rel="stylesheet">
  <script src="/scripts/vendor/prism/prism-flock.min.js" defer></script>
  <script src="/scripts/code-copy-controls.js" defer></script>
  {% endif %}

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

<body class="themed guide-page">
{{ components.navBar({"activeSection": "flock"}) }}
{% if show_hero %}
<section class="flock-hero" aria-label="Three Fleeks leading a Dash toward the viewer">
  <div class="flock-storm" aria-hidden="true">
    <div class="storm-clouds"></div>
    <canvas class="storm-atmosphere"></canvas>
  </div>
  <div class="flock-flight-stage">
    <img class="flight-group flight-dash" src="/images/flock/dash-exhausted.webp" width="600" height="334" alt="An exhausted, slightly unhappy blue Dash flying toward the viewer behind the Fleeks." fetchpriority="high">
    <svg class="flight-group flight-fleeks" width="1200" height="600" viewBox="0 0 1200 600" role="img" aria-labelledby="fleek-formation-title">
      <title id="fleek-formation-title">Three pink Fleeks approaching: a clockwise-banked leader, a closer left companion, and a smaller right companion farther behind.</title>
      <image class="fleek-bird fleek-right" href="/images/flock/fleek-right.webp" x="829" y="14" width="355" height="271" />
      <image class="fleek-bird fleek-left" href="/images/flock/fleek-left-complete.webp" x="-30" y="-52" width="511" height="390" />
      <image class="fleek-bird fleek-leader" href="/images/flock/fleek-leader-complete.webp" x="0" y="30" width="1185" height="570" />
    </svg>
  </div>
</section>
<script src="/scripts/flock-flight.js" defer></script>
<script src="/scripts/flock-storm.js" defer></script>
{% endif %}
<nav class="mobile-section-nav" aria-label="Flock sections">
  <div class="section-nav-links">
    {% for menuItem in side_menu.items %}
    {% set menuItemUrlPath = side_menu.base_path + "/" + menuItem.id %}
    <a href="{{ menuItemUrlPath }}"{% if isCurrentPage(menuItemUrlPath) %} aria-current="page"{% endif %}>{{ menuItem.title }}</a>
    {% endfor %}
  </div>
</nav>
<header class="flock-page-heading">
  {{ components.brand({"hideTagline": true}) }}
</header>

<main>

  <div id="contentColumns">
    <div id="sideMenuColumn">
      <nav id="sideMenu">

        {{ components.sideMenu({"side_menu": side_menu, "isCurrentPage": isCurrentPage}) }}

      </nav>
    </div>

    <div id="contentColumn">
    <!-- ^ "min-width: 0" - a hack to get <pre> tags to respect width in a flex row: https://stackoverflow.com/questions/32035406/how-to-limit-pre-tag-width-inside-flex-container -->
    {{ content }}
    </div>

    <div id="rightSpacerColumn">&nbsp;</div>
  </div>

</main>

{{ components.footer() }}

</body>
</html>
