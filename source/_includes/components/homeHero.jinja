<section class="hero" aria-label="Flock patches built on Flutter commits">
  {{ components.navBar() }}
  <canvas id="plume" aria-hidden="true"></canvas>
  <div class="scene">
    <div class="flock">
      <img class="fleek" src="/images/hero/fleek-embracing-optimized.webp" alt="" width="1560" height="1008" fetchpriority="high">
      <div class="stack">
        {% for commit in recent_commits.flock|take(4) %}
        <article class="commit patch" data-sha="{{ commit.sha|escape }}" {% if not loop.first %}hidden{% endif %}>
          <h2><a href="{{ commit.url|escape }}">{{ commit.message|escape }}</a></h2>
          <p><span class="avatar" aria-hidden="true">{% if commit.avatarUrl %}<img src="{{ commit.avatarUrl|escape }}" alt="" width="29" height="29">{% else %}F{% endif %}</span><span><strong>{{ (commit.authorLogin or commit.authorName)|escape }}</strong> authored <time datetime="{{ commit.authoredAt|escape }}">{{ commit.authoredAt|escape }}</time></span></p>
        </article>
        {% endfor %}
      </div>
    </div>
    <div class="flutter">
      {% for commit in recent_commits.flutter|take(3) %}
      <article class="commit" data-sha="{{ commit.sha|escape }}">
        <h2><a href="{{ commit.url|escape }}">{{ commit.message|escape }}</a></h2>
        <p><span class="avatar" aria-hidden="true">{% if commit.avatarUrl %}<img src="{{ commit.avatarUrl|escape }}" alt="" width="29" height="29">{% else %}F{% endif %}</span><span><strong>{{ (commit.authorLogin or commit.authorName)|escape }}</strong> authored <time datetime="{{ commit.authoredAt|escape }}">{{ commit.authoredAt|escape }}</time></span></p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>
